# Copy to .env and adjust. docker-compose reads this file.

# --- Postgres ---
POSTGRES_DB=income
POSTGRES_USER=income
POSTGRES_PASSWORD=change-me-postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. Include the host you browse from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL is assembled from the POSTGRES_* vars by the backend.
DB_HOST=db
DB_PORT=5432

# --- Seed superuser (created automatically on first boot) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=me@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-superuser

# --- OpenAI (AI classification of untagged transactions) ---
# Leave blank to disable AI features. When set, transaction text (concept,
# counterparty, amount) is sent to OpenAI for classification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
# Port the app is served on (host side).
WEB_PORT=8080
