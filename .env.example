# Copy to .env and adjust. docker-compose reads this file.

# --- Postgres ---
POSTGRES_DB=income
POSTGRES_USER=income
POSTGRES_PASSWORD=change-me-postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. Include the host you browse from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required for HTTPS (Django CSRF). Comma-separated origins, e.g. https://income.example.com
CSRF_TRUSTED_ORIGINS=

# Database URL is assembled from the POSTGRES_* vars by the backend.
# Local compose uses DB_HOST=db. Production compose uses POSTGRES_HOST/PORT.
DB_HOST=db
DB_PORT=5432
# POSTGRES_HOST=192.168.1.185
# POSTGRES_PORT=15432

# --- Seed superuser (created automatically on first boot) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=me@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-superuser

# --- Gemini (AI classification + Telegram finance agent) ---
# Leave blank to disable AI features. Receipt photos and chat go to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Telegram bot ---
# Token from BotFather. Leave blank to keep the bot service idle.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot.
# Message the bot once: it replies with your id if this is empty.
TELEGRAM_ALLOWED_USER_IDS=

# --- Backups (pg_dump job in docker compose) ---
# Writes ./backups/income-share-*.dump. 86400 = daily.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# --- Frontend ---
# Port the app is served on (host side).
WEB_PORT=8080
# Nginx upstream. Compose: api. Standalone TrueNAS app: API container IP/hostname.
# API_HOST=api
# API_PORT=8000

# --- Production (docker-compose.prod.yml on TrueNAS, linux/amd64) ---
# DOCKERHUB_USER=zelenuk
# IMAGE_TAG=latest
