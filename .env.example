# Copy to .env and adjust. docker-compose reads this file.

# --- Postgres ---
POSTGRES_DB=income
POSTGRES_USER=income
POSTGRES_PASSWORD=change-me-postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. Include the host you browse from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL is assembled from the POSTGRES_* vars by the backend.
DB_HOST=db
DB_PORT=5432

# --- Seed superuser (created automatically on first boot) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=me@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-superuser

# --- Gemini (AI classification + Telegram finance agent) ---
# Leave blank to disable AI features. Receipt photos and chat go to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Telegram bot ---
# Token from BotFather. Leave blank to keep the bot service idle.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot.
# Message the bot once: it replies with your id if this is empty.
TELEGRAM_ALLOWED_USER_IDS=

# --- Frontend ---
# Port the app is served on (host side).
WEB_PORT=8080
